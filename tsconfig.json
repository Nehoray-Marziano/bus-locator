{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": false,
    "types": ["@zeppos/device-types"],
    "lib": ["ES2022"]
  },
  "include": [
    "shared/**/*.js",
    "page/**/*.js",
    "app.js",
    "app-widget/**/*.js",
    "app-side/**/*.js",
    "setting/**/*.js",
    "types/**/*.d.ts"
  ]
}
