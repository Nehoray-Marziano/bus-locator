{
  "name": "meitar-bus",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "An on-demand Meitar\u2013Jerusalem commute companion for Amazfit T-Rex 3",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "check": "tsc --noEmit && node scripts/check-source.js",
    "check:provider": "node scripts/probe-provider.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/zeus.cjs build",
    "preview": "node scripts/zeus.cjs preview",
    "dev": "node scripts/zeus.cjs dev"
  },
  "dependencies": {
    "@zeppos/zml": "0.0.43"
  },
  "devDependencies": {
    "@zeppos/zeus-cli": "1.9.3",
    "@zeppos/device-types": "4.0.0",
    "typescript": "7.0.2",
    "prettier": "3.9.10"
  }
}
